{
  "name": "youtube-bilingual-subtitles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube 双语字幕学习插件 — 英文视频的中英对照字幕 + 中文学习辅助",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test test/*.test.ts",
    "integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.28",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.1.3",
    "playwright-core": "^1.57.0",
    "typescript": "^5.9.3",
    "wxt": "^0.20.14"
  }
}
